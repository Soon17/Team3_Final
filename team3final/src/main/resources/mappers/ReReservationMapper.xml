<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.kh.team3final.dao.ReReservationDAO">
	<insert id="insertCp" useGeneratedKeys="true" keyProperty="cp_num">
		insert into car_package(cp_cr_id,cp_ir_num) values (#{cr_id},#{ir_num});
	</insert>
	<insert id="insertReReservation">
		insert into re_reservation (rr_checkin,rr_chekout,rr_price,rr_date,rr_name,
		rr_number,rr_birth,rr_cp_num,rr_me_num) values
		(#{rr_checkIn},#{rr_checkOut},#{rr_price},now(),#{rr_name},
		#{rr_number},#{rr_birth},#{cp_num},#{rr_me_num}); 
	</insert>
</mapper>